    <!-- Home - Application Management -->
    <string name="home_app_management_title">Керування додатками</string>
    <string name="home_app_management_dsp">Тут відображатимуться додатки, які запросили або оголосили Dhizuku.</string>
    <string name="home_user_management_dsp">Керування користувачами та їхніми обліковими записами.</string>
    <!-- Home - Dhizuku -->
    <string name="home_dhizuku_title">Активація через Dhizuku</string>
    <string name="home_dhizuku_dsp">Якщо у вас встановлено інші реалізації Dhizuku, ви можете вільно перемикатися між ними. Будь ласка, &lt;a href=\"%1$s\"&gt;прочитайте довідку&lt;/a&gt;.</string>
    <!-- Home - Shizuku -->
    <string name="home_shizuku_title">Активація через Shizuku</string>
    <string name="home_shizuku_dsp">За допомогою Shizuku ви можете виконувати команди ADB без комп’ютера. Будь ласка, &lt;a href=\"%1$s\"&gt;прочитайте довідку&lt;/a&gt;.</string>
    <!-- Home - Adb -->
    <string name="home_adb_title">Активація через ADB</string>
    <string name="home_adb_dsp">Через підключення ADB (Android Debug Bridge) ви можете виконувати деякі привілейовані команди. Будь ласка, &lt;a href=\"%1$s\"&gt;прочитайте довідку&lt;/a&gt;.</string>
    <string name="home_adb_btn_view_command">Переглянути команду</string>
    <!-- Home - Shutdown -->
    <string name="home_shutdown_title">Вимкнення</string>
    <string name="home_shutdown_dsp">Система не зможе вимкнути Dhizuku, якщо Dhizuku не зробить цього добровільно.</string>
    <!-- Home - Deactivate -->
    <string name="home_deactivate_title">Деактивувати</string>
    <string name="home_deactivate_dsp">Ви впевнені, що хочете деактивувати?</string>
