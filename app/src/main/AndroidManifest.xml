<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ExportedContentProvider,ForegroundServicesPolicy,ScopedStorage,QueryAllPackagesPermission,PackageVisibilityPolicy,ProtectedPermissions,SystemPermissionTypo,UnusedAttribute">

    <permission
        android:name="${applicationId}.permission.API"
        android:description="@string/permission_description"
        android:icon="@drawable/ic_original_foreground"
        android:label="@string/app_name"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_PASSWORD_COMPLEXITY" />

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"
        tools:node="remove" />

    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- Not required: many TV boxes do not declare it and would refuse the install. Without a working
         device policy service the app just shows that it is not activated. -->
    <uses-feature
        android:name="android.software.device_admin"
        android:required="false" />

    <!-- Android TV / set-top boxes: no touch screen needed, D-pad navigation is supported -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:appCategory="productivity"
        android:banner="@drawable/banner_dhizukuf_new"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:pageSizeCompat="enabled"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dhizuku">

        <!-- The launcher entry lives in the two aliases below (Customization switches between them). -->
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true" />

        <!-- The launcher entries: every name (DhizukuF, Dhizuku, Profile Owner, Device Owner) with every icon (DhizukuF, original Dhizuku, Material3), each with its TV banner. Exactly one is switched on; Settings > Customization switches them. The first
             one (DhizukuF + new icon) is the default and keeps the OLD name of the launcher activity on purpose: icons that
             earlier versions left on the home screen point to that name and keep working after an update. The names
             must match LauncherAliases.className() in the code. -->

        <activity-alias
            android:name=".ui.activity.SettingsActivity"
            android:banner="@drawable/banner_dhizukuf_new"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DhizukuFOriginal"
            android:banner="@drawable/banner_dhizukuf_orig"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_original"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_original_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DhizukuDefault"
            android:banner="@drawable/banner_dhizuku_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name_original"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DhizukuOriginal"
            android:banner="@drawable/banner_dhizuku_orig"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_original"
            android:label="@string/app_name_original"
            android:roundIcon="@mipmap/ic_original_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.ProfileOwnerDefault"
            android:banner="@drawable/banner_profile_owner_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/launcher_name_profile_owner"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.ProfileOwnerOriginal"
            android:banner="@drawable/banner_profile_owner_orig"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_original"
            android:label="@string/launcher_name_profile_owner"
            android:roundIcon="@mipmap/ic_original_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DeviceOwnerDefault"
            android:banner="@drawable/banner_device_owner_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/launcher_name_device_owner"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DeviceOwnerOriginal"
            android:banner="@drawable/banner_device_owner_orig"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_original"
            android:label="@string/launcher_name_device_owner"
            android:roundIcon="@mipmap/ic_original_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <activity-alias
            android:name=".alias.DhizukuFMaterial3"
            android:banner="@drawable/banner_dhizukuf_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_material3"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_material3_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DhizukuMaterial3"
            android:banner="@drawable/banner_dhizuku_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_material3"
            android:label="@string/app_name_original"
            android:roundIcon="@mipmap/ic_material3_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.ProfileOwnerMaterial3"
            android:banner="@drawable/banner_profile_owner_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_material3"
            android:label="@string/launcher_name_profile_owner"
            android:roundIcon="@mipmap/ic_material3_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.DeviceOwnerMaterial3"
            android:banner="@drawable/banner_device_owner_new"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_material3"
            android:label="@string/launcher_name_device_owner"
            android:roundIcon="@mipmap/ic_material3_round"
            android:targetActivity=".ui.activity.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.activity.RequestPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Dhizuku.Translucent">
            <intent-filter>
                <action android:name="${applicationId}.action.request.permission" />
                <action android:name="${applicationId}.action.REQUEST_DHIZUKU_PERMISSION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.ProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.FinalizeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".server.MyDhizukuProvider"
            android:authorities="${applicationId}.dhizuku_server.provider;${applicationId}.server.provider"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.server.provider" />
            </intent-filter>
        </provider>

        <service
            android:name=".server.DaemonService"
            android:enabled="true"
            android:foregroundServiceType="remoteMessaging" />

        <receiver
            android:name=".dish.DishReceiver"
            android:exported="true" />

        <receiver
            android:name=".server.DhizukuDAReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/dhizuku_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".server.DaemonReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <!-- booted receiver-->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />

                <!-- device/profile owner changed receiver -->
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_OWNER_CHANGED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
