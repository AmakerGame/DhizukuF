#!/system/bin/sh
# dish - Device Owner console for DhizukuF (works like rish for Shizuku).
# Generated by the DhizukuF app. Keep this file next to dish_dhizukuf.dex.
BASEDIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
[ -n "$BASEDIR" ] || BASEDIR=$(dirname "$0")
DEX="$BASEDIR/dish_dhizukuf.dex"

if [ ! -f "$DEX" ]; then
  echo "dish: cannot find $DEX" >&2
  echo "dish: keep dish and dish_dhizukuf.dex together (export them again from DhizukuF)." >&2
  exit 1
fi

APP_PROCESS=
for p in /system/bin/app_process /system/bin/app_process64 /system/bin/app_process32; do
  if [ -x "$p" ]; then APP_PROCESS=$p; break; fi
done
if [ -z "$APP_PROCESS" ]; then
  echo "dish: app_process not found, this is not an Android shell" >&2
  exit 1
fi

GETPROP=getprop
command -v getprop >/dev/null 2>&1 || GETPROP=/system/bin/getprop
SDK=$($GETPROP ro.build.version.sdk 2>/dev/null)

# Android 14+ refuses to load a writable dex.
case "$SDK" in
  ''|*[!0-9]*) ;;
  *)
    if [ "$SDK" -ge 34 ]; then
      [ -w "$DEX" ] && chmod 400 "$DEX" 2>/dev/null
      if [ "$(id -u)" != 0 ] && [ -w "$DEX" ]; then
        echo "dish: cannot make $DEX read-only, Android $SDK will refuse to load it." >&2
        echo "dish: copy dish and dish_dhizukuf.dex to a normal folder (Termux: \$PREFIX/bin," >&2
        echo "dish: adb shell: /data/local/tmp), not to shared storage (/sdcard)." >&2
        exit 1
      fi
    fi
    ;;
esac

export DISH_PACKAGE=__PACKAGE__

run() {
  "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish \
    com.EdS.DhizukuF.dish.DishMain "$@"
}

# Local flags that the Java client handles without needing an active session still need the dex.
# Empty -c / missing command line: exit 0 without a full interactive session.
if [ $# -eq 1 ] && { [ "$1" = "-c" ] || [ "$1" = "--command" ]; }; then
  exit 0
fi
if [ $# -ge 2 ] && { [ "$1" = "-c" ] || [ "$1" = "--command" ]; }; then
  # dish -c ""  or  dish -c ''  -> empty, exit 0
  if [ $# -eq 2 ] && [ -z "$2" ]; then
    exit 0
  fi
fi

if [ $# -eq 0 ]; then
  if [ -z "$DISH_SKIP_CHECK" ]; then
    run -c ping
    rc=$?
    if [ $rc -ne 0 ]; then
      echo "dish: access check failed - the console was not started." >&2
      exit $rc
    fi
  fi
  if [ -t 0 ]; then export DISH_TTY=1; fi
  exec "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish \
    com.EdS.DhizukuF.dish.DishMain
fi

exec "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish \
  com.EdS.DhizukuF.dish.DishMain "$@"
