#!/system/bin/sh
# dish - Device Owner console for DhizukuF (works like rish for Shizuku).
# Generated by the DhizukuF app. Keep this file next to dish_dhizukuf.dex.
BASEDIR=$(dirname "$0")
DEX="$BASEDIR/dish_dhizukuf.dex"
APP_PROCESS=/system/bin/app_process

if [ ! -f "$DEX" ]; then
  echo "dish: cannot find $DEX" >&2
  echo "dish: keep dish and dish_dhizukuf.dex together (export them again from DhizukuF)." >&2
  exit 1
fi

if [ ! -x "$APP_PROCESS" ]; then
  echo "dish: $APP_PROCESS not found, this is not an Android shell" >&2
  exit 1
fi

# Android 14+ requires dex files to be read-only.
if [ "$(getprop ro.build.version.sdk)" -ge 34 ] 2>/dev/null; then
  [ -w "$DEX" ] && chmod 400 "$DEX"
fi

export DISH_PACKAGE=__PACKAGE__

run() {
  "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish com.EdS.DhizukuF.dish.DishMain "$@"
}

if [ $# -eq 0 ]; then
  # Interactive mode: make sure dish may run BEFORE the console opens. If dish is disabled in
  # DhizukuF, DhizukuF is not the Device Owner, or the access is refused, stop here and no
  # prompt is shown. The first run also shows the approval window.
  # Set DISH_SKIP_CHECK=1 to skip this check.
  if [ -z "$DISH_SKIP_CHECK" ]; then
    run -c ping || exit $?
  fi
  if [ -t 0 ]; then export DISH_TTY=1; fi
  exec "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish com.EdS.DhizukuF.dish.DishMain
fi

exec "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=dish com.EdS.DhizukuF.dish.DishMain "$@"
